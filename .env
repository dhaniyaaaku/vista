# Supabase.
#
# The publishable key is committed deliberately. It is designed to ship in the browser bundle —
# anyone who opens the site can read it out of the JavaScript, so hiding it in an env file would
# be theatre. What actually protects the data is row-level security: every table has RLS enabled
# and policies that only ever match rows where user_id = auth.uid(), so this key can do nothing
# except act on behalf of whoever is signed in.
#
# The SECRET key (sb_secret_...) is the opposite and must never appear here, in the repo, or in
# any client code. It bypasses RLS entirely.

VITE_SUPABASE_URL=https://fttoayjbjzaenzibpfmc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_hX9NPeUtrnLDUqI1ol5btw_KQLdEU21
